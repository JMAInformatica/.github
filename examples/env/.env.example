# Copie este arquivo para .env e preencha os valores.
# .env fica fora do git e fora da imagem. .env.example permanece no repositório
# com TODAS as variáveis que o projeto lê, sem segredo real.

POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_DB=app

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Default=

# Porta publicada pelo compose, quando houver
APP_PORT=8080
